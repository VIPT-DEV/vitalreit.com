# Copy to .env and fill in. Never commit .env.
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"

# Server
HOST=0.0.0.0
PORT=1337

# Secrets (APP_KEYS is a comma-separated list of 2+ secrets)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Database (local development uses SQLite at .tmp/data.db)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
