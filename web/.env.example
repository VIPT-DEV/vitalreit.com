# Copy to .env.local and fill in. Never commit real values.
# Server-only: none of these use the NEXT_PUBLIC_ prefix, so they never reach the browser.

# Strapi base URL, e.g. http://localhost:1337 for local development
STRAPI_URL=
# Strapi API token (read-only: find / findOne on content types)
STRAPI_API_TOKEN=

# Shared secret Strapi's webhook sends in the x-revalidate-secret header (Phase 4)
REVALIDATE_SECRET=
# Shared secret for Strapi Preview / Next.js draft mode (Phase 4)
PREVIEW_SECRET=
